{
  "name": "nigerianstates-map",
  "version": "0.1.35",
  "description": "A React Map library for Nigerian States Map",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ReactJs",
    "SVG",
    "Wrapper",
    "JavaScript",
    "Open Source",
    "CSS"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/allindeveloper/nigerianstates-map"
  },
  "author": {
    "name": "Uchendu Precious",
    "email": "uchendubozz@gmail.com",
    "url": "https://github.com/allindeveloper"
  },
  "contributors": [
    {
      "name": "Onyekaoha Juliet",
      "email": "julietonyekaoha@gmail.com",
      "url": "https://github.com/esotericjules"
    }
  ],
  "license": "Apache",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.5.3",
    "vite": "^8.3.4",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "format": "biome format --write .",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false .",
    "lint": "biome lint . && yarn typecheck",
    "typecheck": "tsc --noEmit",
    "validate": "biome check . && yarn typecheck",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,html}": "biome check --write"
  }
}
